{
  "manifest_version": 2,
  "name": "Privacy Inspector",
  "version": "0.1.0",
  "description": "Auditoria de privacidade por aba: rastreadores de terceira parte, cookies, storage, fingerprinting, hijacking e pontuação.",
  "browser_specific_settings": {
    "gecko": {
      "id": "privacy-inspector@insper.edu.br",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "cookies",
    "tabs",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "domain.js",
      "data/trackers.js",
      "score.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_action": {
    "default_title": "Privacy Inspector",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
